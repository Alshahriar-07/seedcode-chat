# Seed Code Chat - environment variables
# Copy to .env (never commit .env) and fill in your real keys.
# The server reads as many of OPENROUTER_API_KEY_1.._6 as are set.
# Each request uses only the current active key (api-key-manager.js).
# On a 401/402/403/429 from the active key, the active key advances to
# the next one and a clean error is returned; the failed request is
# never retried. At least one key is required for chat and model
# listing to work.

OPENROUTER_API_KEY_1=your_openrouter_api_key_here
OPENROUTER_API_KEY_2=your_openrouter_api_key_here
OPENROUTER_API_KEY_3=your_openrouter_api_key_here
OPENROUTER_API_KEY_4=your_openrouter_api_key_here
OPENROUTER_API_KEY_5=your_openrouter_api_key_here
OPENROUTER_API_KEY_6=your_openrouter_api_key_here
